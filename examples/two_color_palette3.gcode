M190 S60 ; wait for bed temperature
M109 S200 T0 ; wait for nozzle temperature
M83 ; relative extrusion (required by P2PP)
G28 ; home all axes
G92 E0.00000 ; reset extruder

;P2PP PALETTE3
;P2PP SPLICEOFFSET=100
;P2PP EXTRAENDFILAMENT=0
;P2PP PRINTERPROFILE=30313233343536373031323334353637

; ============================================================
; GCODE BODY
; ============================================================

; [--P2PP-- Color Change] - T0
; gcode_process_toolchange(0): current_tool was -1, no splice; current_tool=0

; ---- Layer 0 — T0 (red) ------------------------------------

;BEFORE_LAYER_CHANGE
G92 E0.00000
;0.2

;LAYERHEIGHT 0.2
G1 Z0.200 F1800 ;recorded Z=0.2
G1 X10.000 Y10.000 F9000 ; travel (G1 XY, no E) — sets backpass_line here

; Print moves — X-only lines, each +30 mm extrusion
G1 X60.000 E30.00000 F1200 ; total =  30.000
G1 X10.000 E30.00000 ; total =  60.000
G1 X60.000 E30.00000 ; total =  90.000
G1 X10.000 E30.00000 ; total = 120.000
G1 X60.000 E30.00000 ; total = 150.000

; ---- Tool change T0 → T1 -----------------------------------

;BEFORE_LAYER_CHANGE
G92 E0.00000
;0.4

;LAYERHEIGHT 0.4
G1 Z0.400 F1800 ;recorded Z=0.4

; Travel to wipe tower — this G1 XY (no E) updates backpass_line to HERE.
; When ; CP TOOLCHANGE START is parsed, back-classification rewinds only
; to this line — layer-0 print moves above remain CLS_NORMAL.
; [--P2PP-- tool unload] - G1 X160.000 Y70.000 F9000

; CP TOOLCHANGE START
; [--P2PP-- tool unload] - G1 X162.000 Y72.000 F9000

; CP TOOLCHANGE UNLOAD
; [--P2PP-- tool unload] - G1 E-0.80000 F2100

; [--P2PP-- Color Change] - T1
; T1 fires gcode_process_toolchange(1):
;   location = 150.000 + 100 = 250.000 mm
;   splice 1: { position=250.000, length=250.000, tool=0 }
;   current_tool = 1
; Block initially = CLS_TOOL_PURGE (T sets it), then back-classified to
; CLS_TOOL_UNLOAD by the ; CP TOOLCHANGE LOAD marker below.

; CP TOOLCHANGE LOAD
; [--P2PP-- tool unload] - G1 E0.80000 F2100

G1 X162.000 Y72.000 F8640 ; P2PP positional alignment
G1 Z0.400 F8640 ; P2PP positional alignment
; CP TOOLCHANGE WIPE
G1 F8640 ; correct speed
G1 X160.000 Y90.000 E10.00000 F1200 ; +10.000 mm (CLS_TOOL_PURGE, counted)
;   total_material_extruded = 160.000 mm

; CP TOOLCHANGE END
; Block = CLS_ENDPURGE.  The FIRST non-tower G1 XY move below triggers
; the CLS_ENDPURGE → CLS_NORMAL transition (mcf.py first-pass line ~417).
G1 X10.000 Y10.000 F9000 ; ← triggers ENDPURGE→NORMAL; no E, not counted

; ---- Layer 1 — T1 (green) ----------------------------------

;P2PP START Z/E alignment processing
G1 Z0.400 ;>P2PP correct z-moves<
G1 F1200 ; P2PP Correct for speed, top to PURGETOPSPEED
;P2PP END Z/E alignment processing
G1 X60.000 E30.00000 F1200 ; total = 190.000
G1 X10.000 E30.00000 ; total = 220.000
G1 X60.000 E30.00000 ; total = 250.000
G1 X10.000 E30.00000 ; total = 280.000
G1 X60.000 E30.00000 ; total = 310.000

; ============================================================
; END GCODE
; ============================================================

M104 S0
M140 S0
G1 X0.000 Y200.000 F9000
M84

